# =============================================================================
# FraudGNN — qué NO va al repositorio
# =============================================================================

# --- Credenciales: NUNCA se versionan ---------------------------------------
# El dataset se baja con las credenciales de cada usuario (ver README §2).
kaggle.json
.kaggle/
access_token
.env
*.pem
*.key

# --- Datos y artefactos: se regeneran corriendo el pipeline ------------------
data/raw/*
data/processed/*
data/graph/*
models/*
artifacts/*
reports/*
historial/*
# ...pero se conserva la estructura de carpetas y los resultados archivados
!**/.gitkeep
# El baseline XGBoost SÍ se versiona: está congelado por diseño, no depende del
# grafo ni de gnn.hidden_dims, y es la MISMA vara de medir para todas las
# configuraciones. Versionarlo evita reentrenarlo en cada máquina (10 min) y
# garantiza que todas las corridas se comparen contra el idéntico baseline.
!models/xgboost_baseline.json
!reports/xgboost_val_metrics.json
!reports/smoke_synthetic/
!reports/smoke_synthetic/**

# --- Entornos virtuales ------------------------------------------------------
.venv/
venv/
env/
ENV/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Logs de corridas y temporales de escritura atómica ----------------------
*.log
*.tmp

# --- Caché de herramientas ---------------------------------------------------
scripts/.vis-network.min.js

# --- Sistema operativo / editores --------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
